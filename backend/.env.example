# Copy this file to backend/.env and fill values locally.
# Never commit the real backend/.env file.

# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- 题库 ----
# 默认 backend/data/questions.json
QUESTION_BANK_PATH=

# ---- 检索阈值（三态判定，详见 docs/question-bank-design.md）----
SEARCH_ORIGINAL_THRESHOLD=0.72
SEARCH_SIMILAR_THRESHOLD=0.45
SEARCH_SIMILAR_ITEM_MIN_SCORE=0.35
SEARCH_MAX_SIMILAR=5
# downgrade（默认，未核验题目不判原题）| allow
SEARCH_UNVERIFIED_POLICY=downgrade
SEARCH_MAX_INPUT_LENGTH=4000

# ---- 大模型（Agent 链路，王圣杰）----
LLM_API_KEY=
# DeepSeek OpenAI-compatible endpoint; switch values for another provider if needed.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
